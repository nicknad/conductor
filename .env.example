# Conductor environment template.
#
# Copy the values you need into the service environment (systemd
# EnvironmentFile=, your shell, or a local .env file). Real secrets must
# never be committed.
#
# Precedence: defaults < JSON config file < these environment variables.
# The CLI flag `--config <path>` wins over CONDUCTOR_CONFIG.

# Path to the JSON configuration file. See config/conductor.example.json.
CONDUCTOR_CONFIG=config/conductor.local.json

# Listener address. The service is TLS-only; there is no plaintext option.
CONDUCTOR_HTTP_BIND=127.0.0.1:8443

# Root for quarantine/, artifacts/, and database/.
CONDUCTOR_STORAGE_ROOT=data

# Per-request timeout in seconds (must be greater than zero). It includes
# request preparation as well as the worker run, and must exceed
# max_execution_deadline_secs plus the 2s worker termination grace.
CONDUCTOR_REQUEST_TIMEOUT_SECS=360

# PEM certificate and private key for the TLS listener.
CONDUCTOR_TLS_CERT_PATH=tls/cert.pem
CONDUCTOR_TLS_KEY_PATH=tls/key.pem

# Maximum simultaneous upload validations (must be greater than zero).
CONDUCTOR_MAX_CONCURRENT_UPLOADS=8

# Startup sweep age bounds for crash leftovers (seconds, greater than zero).
CONDUCTOR_QUARANTINE_TTL_SECS=3600
CONDUCTOR_STAGING_TTL_SECS=3600

# Runtime names activation and execution may run, comma-separated
# (must contain at least one name). This filters the manifest's declared
# runtime metadata; it is not a sandbox.
CONDUCTOR_ALLOWED_RUNTIMES=rust

# Host ceiling for a requested execution deadline (seconds, greater than zero).
# An omitted request deadline defaults to 30s, clamped down to this ceiling.
CONDUCTOR_MAX_EXECUTION_DEADLINE_SECS=300

# Maximum simultaneous worker executions (1..=Semaphore::MAX_PERMITS).
CONDUCTOR_MAX_CONCURRENT_EXECUTIONS=4

# OTLP/HTTP metrics base endpoint (external collector). Metrics are disabled
# when unset: no reader, no export thread, no network client. When set it must
# be an http:// or https:// URL without userinfo; trailing slashes are trimmed
# and /v1/metrics is appended unless the full signal URL is already supplied.
# HTTPS export uses the compiled-in rustls backend. There is no /metrics scrape
# endpoint and metrics are never stored in SQLite.
# CONDUCTOR_OTLP_ENDPOINT=http://127.0.0.1:4318
# Seconds between exports (must be greater than zero).
CONDUCTOR_METRICS_EXPORT_INTERVAL_SECS=15
# Per-export timeout (must be greater than zero and strictly below the interval).
CONDUCTOR_METRICS_EXPORT_TIMEOUT_SECS=5
# Resource attribute deployment.environment.name (bounded, control-free).
CONDUCTOR_DEPLOYMENT_ENVIRONMENT=development

# Operator bearer token. Values here are secret: prefer CONDUCTOR_API_TOKEN_FILE
# so the token is not embedded in a service unit or shell history.
CONDUCTOR_API_TOKEN=replace-with-a-long-random-token
# CONDUCTOR_API_TOKEN_FILE=/etc/conductor/api-token

# Optional JSON array of trusted signing keys, replacing the config file's
# trusted_keys. Each entry has key_id, algorithm ("ed25519"), and
# public_key_base64 (standard base64 of the raw 32-byte public key).
# CONDUCTOR_TRUSTED_KEYS_FILE=/etc/conductor/trusted-keys.json
