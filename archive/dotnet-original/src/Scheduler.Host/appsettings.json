{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost",
  "JobScheduler": {
    "DataRoot": "data",
    "DatabasePath": "data/jobscheduler.db",
    "ArtifactsRoot": "data/artifacts",
    "StagingRoot": "data/staging",
    "PackagePublicKeyPath": "keys/package-signing.pub.pem",
    "LogsRoot": "logs",
    "BackupRoot": "data/backups",
    "GlobalConcurrencyLimit": 8,
    "GracefulShutdownDrainTimeout": "00:01:00",
    "DefaultDrainPolicy": "Wait",
    "ExecutionHeartbeat": "00:30:00",
    "StuckCheckInterval": "00:01:00",
    "SecretStore": {
      "StoreRoot": "data/secrets",
      "KeyPath": "keys/secret-store.key"
    },
    "ManagementApi": {
      "Enabled": true,
      "AllowRemoteAccess": false,
      "Port": 5080,
      "Credentials": [
        {
          "Reference": "management-api-admin",
          "Scopes": [
            "read",
            "install",
            "validate",
            "activate",
            "deactivate",
            "rollback",
            "remove",
            "manual-run",
            "secret-admin"
          ]
        }
      ]
    }
  }
}
