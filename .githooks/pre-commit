#!/bin/sh
# Pre-commit gate: formatting must be clean and the workspace must compile
# lint-clean. Run `cargo fmt --all` to fix formatting issues.
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "[pre-commit] cargo fmt --all --check"
cargo fmt --all --check || {
  echo "[pre-commit] FAILED: formatting is not clean. Run 'cargo fmt --all' and re-stage." >&2
  exit 1
}

echo "[pre-commit] cargo clippy (warnings denied)"
cargo clippy --workspace --all-targets -- -D warnings || {
  echo "[pre-commit] FAILED: clippy reported lints." >&2
  exit 1
}

echo "[pre-commit] OK"
